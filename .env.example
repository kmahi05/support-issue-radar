# Copy to api/.env (the API reads it from its working directory). Dev defaults only; never commit real values.

# --- Postgres (PostgreSQL 16 on localhost:5432) ---
# Used by scripts/db_setup.py and the tests (superuser, dev only).
PG_SUPERUSER_URL=postgresql://postgres:postgres@localhost:5432/postgres
# Used by scripts/migrate.py (owner role).
MIGRATE_DATABASE_URL=postgresql://sir_owner:sir_owner@localhost:5432/support_radar
# API: user requests (RLS applies) and worker/background/auth (BYPASSRLS).
APP_DATABASE_URL=postgresql+asyncpg://sir_app:sir_app@localhost:5432/support_radar
WORKER_DATABASE_URL=postgresql+asyncpg://sir_worker:sir_worker@localhost:5432/support_radar

# --- Auth ---
# At least 32 bytes. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-dev-only-change-me-0123456789
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
INVITE_TTL_SECONDS=604800

# --- Secrets at rest (ingest HMAC secret, Slack webhook URL) ---
# Fernet key. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

# --- Gemini ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_STRONG=gemini-2.5-pro
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
# Backfill estimate per 1,000 tickets (PRD §6); check current Gemini pricing.
LLM_COST_PER_1K_TICKETS_USD=1.30

# --- Storage ---
CHROMA_PATH=./data/chroma
STORAGE_DIR=./data/storage
MAX_CSV_UPLOAD_BYTES=52428800

# --- HTTP ---
WEB_ORIGIN=http://localhost:3003
RATE_LIMIT_ENABLED=true
LOG_LEVEL=INFO

# --- Web (web/.env.local, see web/.env.example) ---
# API_URL=http://localhost:8003
